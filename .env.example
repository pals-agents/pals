# Copy to .env and fill in. `npm run keys` generates the secrets.

# --- server ---
PORT=8787
PUBLIC_BASE_URL=http://localhost:8787
SESSION_SECRET=

# --- brain (console.anthropic.com → API keys). Empty = offline brain. ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_BUILD_MODEL=claude-sonnet-5-5
ANTHROPIC_MEMORY_MODEL=claude-haiku-5-5
ENABLE_WEB_SEARCH=false

# --- storage. Empty DATABASE_URL = local file store in data/ ---
DATABASE_URL=
MEMORY_ENCRYPTION_KEY=

# --- solana (Helius dashboard → RPC URL). Used for live on-chain tools, ownership checks and minting. ---
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=
MINT_ENABLED=false
# user = holder's wallet pays + sends (default, required on mainnet); server = mint wallet pays (devnet testing)
MINT_MODE=user
MINT_AUTHORITY_SECRET_KEY=
PALS_COLLECTION=
# burn-to-mint: every mint burns MINT_BURN_AMOUNT whole tokens of PALS_TOKEN_MINT from the minter's wallet.
# Leave either empty to mint without a burn. Works with SPL Token and Token-2022 mints. MINT_MODE=user only.
PALS_TOKEN_MINT=
MINT_BURN_AMOUNT=
PALS_TOKEN_SYMBOL=$PALS

# --- compute economy ---
TREASURY_WALLET=
COST_PER_MSG_USD=0.004
BASE_POOL_PCT=40
CAP_MULTIPLIER=3
PAYOUT_DAYS=7
TRIAL_MSGS_PER_DAY=20
# daily budget used before the first epoch is recorded (npm run epoch)
FALLBACK_DAILY_BUDGET_USD=5
CHAT_RATE_PER_MIN=20
